# Origem da care-senior-api usada pelo cliente HTTP no browser (as rotas
# geradas já trazem /api/v1). Vazia em dev: o proxy do Vite (ver
# API_PROXY_TARGET) repassa /api e evita CORS.
VITE_API_URL=

# Só pro dev server/scripts (não vai pro bundle): onde a care-senior-api roda.
API_PROXY_TARGET=http://localhost:3000
